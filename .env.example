# ============================================================
# API Proyecto Formativo - variables de entorno
# Copia este archivo como .env y complétalo.
# El .env NO se sube a Git: lleva la contraseña de la base.
# ============================================================

PORT=3000
NODE_ENV=development

# --- Base de datos: elige UNA de las dos formas ---------------

# (A) En tu equipo: variables sueltas.
PGHOST=localhost
PGPORT=5432
PGDATABASE=essence_api
PGUSER=postgres
PGPASSWORD=tu_clave_de_postgres

# (B) En la nube (Neon, Supabase, Render): una sola cadena.
#     Si está presente, tiene prioridad sobre las de arriba.
# DATABASE_URL=postgresql://usuario:clave@host-pooler.region.aws.neon.tech/essence_api?sslmode=require

# SSL: se decide solo (apagado en localhost, encendido fuera).
# Descomenta solo si necesitas forzarlo.
# PGSSL=true

# --- CORS -----------------------------------------------------
# Orígenes que pueden llamar a la API desde un navegador.
# * = cualquiera. En producción conviene poner el dominio real.
CORS_ORIGINS=*

# --- App móvil: sesión ----------------------------------------
# Clave para firmar los tokens de login. Pon una frase larga y aleatoria.
# En Vercel es OBLIGATORIA (Settings > Environment Variables).
JWT_SECRETO=cambia-esto-por-una-frase-larga-y-aleatoria
# JWT_DURACION=7d

# Usuario administrador que crea `npm run db:movil` (solo si no existe).
ADMIN_CORREO=admin@essence.com
ADMIN_PASSWORD=Essence2026*
ADMIN_NOMBRE=Yésica Restrepo

# --- App móvil: Wompi (pagos en línea) ------------------------
# Llaves de https://comercios.wompi.co > Desarrolladores (modo Sandbox).
# Sin WOMPI_LLAVE_PRIVADA la app sigue funcionando: solo se desactiva el
# botón de link de pago y los abonos se registran a mano.
WOMPI_ENTORNO=sandbox
WOMPI_LLAVE_PUBLICA=pub_test_xxxxxxxx
WOMPI_LLAVE_PRIVADA=prv_test_xxxxxxxx
# Secreto de "Eventos" (sección Secretos para integración técnica).
WOMPI_SECRETO_EVENTOS=test_events_xxxxxxxx

# --- Correo (recuperar contraseña y avisos de registro) -------
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de
# aplicación" (16 letras) en https://myaccount.google.com/apppasswords
CORREO_SMTP_HOST=smtp.gmail.com
CORREO_SMTP_PUERTO=465
CORREO_USUARIO=tucorreo@gmail.com
CORREO_CLAVE=xxxx xxxx xxxx xxxx
CORREO_REMITENTE=tucorreo@gmail.com
# Solo para pruebas en tu PC: no envía nada, guarda el correo en memoria.
# CORREO_MODO=prueba

# --- Datos de pago que ve el cliente en la app ------------------------------
# A qué cuenta transferir (sale cuando el cliente reporta un pago) y dónde
# queda el punto físico para pagar en efectivo. Son opcionales.
# PAGO_TRANSFERENCIA_INFO=Nequi 300 000 0000 a nombre de Yésica ...
# PUNTO_FISICO_DIRECCION=Avenida 30 # 31-16, La Pintada, Antioquia
